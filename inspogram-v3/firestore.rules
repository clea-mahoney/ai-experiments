rules_version = '2';
// Each person can read and write only their own data, under users/{their uid}.
// Old top-level collections (boards, captures) from v1/v2 are no longer readable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
